---
import WhatsAppButton from './WhatsAppButton.astro';
import { negocio } from '../data/negocio.js';
import { url } from '../utils/url.js';

const links = [
  { href: url('/'), label: 'Início' },
  { href: url('/cardapio/'), label: 'Cardápio' },
  { href: url('/sobre/'), label: 'Sobre' },
  { href: url('/contato/'), label: 'Contato' },
];

const atual = Astro.url.pathname;
// A home chega como `/base` (sem barra final) e os links como `/base/`.
// Comparar sem a barra final evita perder o estado ativo do "Início".
const semBarra = (p) => p.replace(/\/+$/, '') || '/';
const isAtivo = (href) => semBarra(atual) === semBarra(href);
---

<header class="header">
  <div class="container header__inner">
    <a href={url('/')} class="brand" aria-label={`${negocio.nome} — página inicial`}>
      <span class="brand__mark" aria-hidden="true">🥖</span>
      <span class="brand__name">{negocio.nome}</span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      <ul class="nav__list">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={['nav__link', { 'is-active': isAtivo(l.href) }]}
              aria-current={isAtivo(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__cta">
      <WhatsAppButton label="Pedir" />
    </div>
  </div>
</header>

<style>
  .header {
    background-color: var(--marrom);
    color: var(--creme);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--creme);
    white-space: nowrap;
  }

  .brand__mark {
    font-size: 1.4rem;
  }

  .nav {
    margin-inline: auto;
  }

  .nav__list {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .nav__link {
    color: rgba(251, 244, 230, 0.85);
    font-weight: 600;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--trigo);
    border-color: var(--trigo);
  }

  .header__cta :global(.btn) {
    padding: 0.6rem 1.1rem;
  }

  @media (max-width: 46rem) {
    .header__inner {
      flex-wrap: wrap;
      gap: 0.75rem 1rem;
    }

    .nav {
      order: 3;
      width: 100%;
      margin-inline: 0;
    }

    .nav__list {
      gap: 1.1rem;
    }

    .header__cta {
      margin-left: auto;
    }
  }
</style>
